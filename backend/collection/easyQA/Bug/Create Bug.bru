  auth: inherit
}

body:json {
  {
    "title": "Botão Procurar é habilitado quando as datas não são inseridas",
    "description": "",
    "severity": "MEDIUM",
    "status": "OPEN"
  }
}

vars:post-response {
  bugNumber: 
}

script:post-response {
  bru.setEnvVar("bugNumber", res.getBody().bugNumber);
}

settings {
  encodeUrl: true
  timeout: 0
}
